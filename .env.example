# Required by FastAPI and Alembic. PostgreSQL only; environment overrides .env.
# Replace CHANGE_ME locally; URL-encode reserved characters in the password.
# Never publish the real value. Production: /etc/ticketyn/ticketyn.env (systemd).
DATABASE_URL=postgresql+psycopg://ticketyn:CHANGE_ME@127.0.0.1:5432/ticketyn

# Development only: optional absolute path outside the repository, private directory.
# MAIL_KEYS_PATH=/home/your-user/.config/ticketyn/mail/keys.json
# Production uses /etc/ticketyn/mail/keys.json; do not add this variable to the
# managed /etc/ticketyn/ticketyn.env (backup/restore currently accept DATABASE_URL only).

# Development callback, using Vite's existing /api proxy. Must exactly match the
# URI registered with the OAuth provider. HTTPS required outside loopback.
# MAIL_OAUTH_REDIRECT_URI=http://localhost:5173/api/mail-notifications/oauth/callback
# In production configure this public URI in a systemd override, not the managed
# ticketyn.env: its backup/restore contract currently accepts DATABASE_URL only.
